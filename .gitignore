# Repo-root ignores (env files live here, above the nested circles/.gitignore)
.env
.env.local
.env*.local
# Backups of env files hold secrets too (e.g. .env.local.bak-20261008-minio)
.env*.bak*

# Deploy-time atomic-release artifacts (see scripts/deploy-common.sh) —
# live one level above the app checkout, deliberately outside its
# tsconfig scope so `next build` never scans a previous release's copied
# source as project input.
/releases/
/current
/current.tmp
